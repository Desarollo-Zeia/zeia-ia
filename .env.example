# ============================================================
# ZEIA — Asistente de IA para clientes (multi-base)
# Copia este archivo a `.env` y completa los valores.
# ============================================================
# Dos bases independientes: ENERGIA y AMBIENTAL.
# En la computadora del trabajo ambas corren en 127.0.0.1:
#   - Energía   → puerto 5432 (base `energy`)
#   - Ambiental → puerto 5433 (base `valhalladb`)
# En casa se accede por túnel SSH (USE_SSH_TUNNEL_* = true).

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Base ENERGÍA ----------
ENERGIA_DB_HOST=127.0.0.1
ENERGIA_DB_PORT=5432
ENERGIA_DB_USER=postgres
ENERGIA_DB_PASSWORD=XXXXXXXX
ENERGIA_DB_NAME=energy
USE_SSH_TUNNEL_ENERGIA=false

# ---------- Base AMBIENTAL ----------
AMBIENTAL_DB_HOST=127.0.0.1
AMBIENTAL_DB_PORT=5433
AMBIENTAL_DB_USER=postgres
AMBIENTAL_DB_PASSWORD=XXXXXXXX
AMBIENTAL_DB_NAME=valhalladb
USE_SSH_TUNNEL_AMBIENTAL=false

# ---------- Túnel SSH — Energía (bastión trabajo) ----------
SSH_KEY_ENERGIA=energy.pem
SSH_USER_ENERGIA=ubuntu
SSH_HOST_ENERGIA=54.242.41.196
SSH_REMOTE_HOST_ENERGIA=172.31.29.136
SSH_REMOTE_PORT_ENERGIA=5432

# ---------- Túnel SSH — Ambiental (bastión valhallaprod) ----------
SSH_KEY_AMBIENTAL=valhallaprod.pem
SSH_USER_AMBIENTAL=ubuntu
SSH_HOST_AMBIENTAL=ec2-44-206-41-101.compute-1.amazonaws.com
SSH_REMOTE_HOST_AMBIENTAL=172.31.29.136
SSH_REMOTE_PORT_AMBIENTAL=5432

# ---------- Modelos ----------
DEFAULT_MODEL=qwen/qwen3-coder

# ---------- ElevenLabs (voz) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
VOICE_SUMMARY_MODEL=google/gemini-2.5-flash

# ---------- Telegram (avisos del monitor al equipo) ----------
# Token de @BotFather e id del grupo (lo muestra scripts/telegram_setup.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Avisos automáticos (los corre el bot: scripts\telegram_bot.cmd)
#   simular → evalúa y guarda lo que avisaría, SIN mandar nada (por defecto;
#             verlo con /avisos en el grupo) · enviar → avisa al grupo · apagado
AVISOS_MODO=simular
AVISOS_HORARIO=08:00-20:00   # los 🟠 solo en este horario (los 🔴 a toda hora)
AVISOS_RESUMEN=08:00         # resumen 🟡 del día anterior, sin sonido
AVISOS_CICLO_MIN=5